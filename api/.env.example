# Copiar a .env y ajustar. El archivo .env real esta excluido de git (.gitignore, RNF7).
# Los valores de abajo coinciden con los docker-compose de los hitos del repo.

# --- Servicio HTTP ---
API_HOST=0.0.0.0
API_PORT=8000
DEP_TIMEOUT_S=3.0
MAX_LIMIT=100

# --- MongoDB (Hito 4) ---
MONGODB_URI=mongodb://admin:admin@localhost:27017
MONGODB_DATABASE=fixture2030

# --- Neo4j (Hito 5) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fixture2030
NEO4J_DATABASE=neo4j

# --- Cassandra (Hito 6) ---
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fixture2030_comentarios
# Contenedor Docker de Cassandra. Solo se usa si el driver nativo no carga en la
# maquina (p. ej. Python 3.12), en cuyo caso el adaptador usa cqlsh dentro de el.
CASSANDRA_CONTAINER=fixture2030-cassandra

# --- Redis (Hito 7) ---
REDIS_URL=redis://localhost:6379

# --- InfluxDB 3 Core (Hito 8) ---
INFLUX_URL=http://localhost:8181
INFLUX_DATABASE=fixture2030_vivo
# El token se genera en el Hito 8 (archivo .influxdb3-token). Pegarlo aca o
# exportarlo como variable. NO versionar el token (RNF7).
INFLUXDB3_TOKEN=

# --- IRIS (Hito 9) ---
IRIS_HOST=localhost
IRIS_PORT=1972
IRIS_NAMESPACE=USER
IRIS_USER=_SYSTEM
IRIS_PASSWORD=SYS
