# Configuracion local del monitoreo (Hito 13).
# scripts/iniciar_monitoreo copia este archivo a .env (excluido de Git) y
# reemplaza la contrasena de Grafana por una generada al azar en cada maquina.
# No escribir valores reales en este archivo de ejemplo (RNF6).

# Usuario administrador de Grafana. La contrasena real solo vive en .env.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar-esto

# Conexion del mongodb_exporter a MongoDB (Hito 4). Son las credenciales del
# ambiente de laboratorio del docker-compose del Hito 4, no de produccion.
MONGODB_EXPORTER_URI=mongodb://admin:admin@host.docker.internal:27017/admin
