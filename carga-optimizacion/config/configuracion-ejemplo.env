# Configuracion del Hito 12. Copiar a 'configuracion.env' (excluido de git) solo
# si hay que cambiar algun valor en tu maquina. Estos valores coinciden con los
# docker-compose de los Hitos 6 y 7 y con la API del Hito 10.
# No hay credenciales: Cassandra y Redis del laboratorio no usan contrasena.

# URL de la API del Hito 10 (la carga SIEMPRE entra por aca). Se usa 127.0.0.1
# y no localhost: en Windows, localhost prueba primero IPv6 y puede sumar demoras
# de conexion que no son de la API.
API_URL=http://127.0.0.1:8000

# Contenedores y keyspace (solo para medir y validar con cqlsh / nodetool / redis-cli)
CASSANDRA_CONTAINER=fixture2030-cassandra
CASSANDRA_KEYSPACE=fixture2030_comentarios
REDIS_CONTAINER=fixture2030-redis
