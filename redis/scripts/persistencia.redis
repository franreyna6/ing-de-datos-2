# =============================================================================
# persistencia.redis - Hito 7 (Grupo 8)
# Estado que debe sobrevivir a un reinicio del contenedor (RNF2, RF1).
# ejecutar_todo lo corre ANTES y DESPUES de 'docker compose restart redis'.
# Persistencia configurada en el Compose: AOF (--appendonly yes) + snapshot
# RDB (--save 60 1), con los datos en ~/docker/data/redis.
# Es de SOLO LECTURA.
# Ejecucion: sh /scripts/ejecutar_bloques.sh /scripts/persistencia.redis
# =============================================================================

# --- 1. Sesion de la muestra: el Hash y su TTL ---
# El TTL debe seguir corriendo (menor o igual al anterior), no reiniciarse ni perderse (-1).
HGET sesion:S0001 usuario_id
TTL sesion:S0001

# --- 2. Datos conservados (sin TTL): contador de visitas y ranking de la encuesta ---
GET partido:F2030-001:visitas
ZREVRANGE encuesta:F2030-001:figura 0 2 WITHSCORES

# --- 3. Claves totales y claves con TTL ---
INFO keyspace
