# Configuracion de la evaluacion de conectividad (Hito 11) - EJEMPLO SIN SECRETOS.
#
# Copiar a config/configuracion.env (excluido de Git) y completar los valores
# marcados con <...>. Los nombres son LOS MISMOS que lee la API del Hito 10
# (api/.env), asi la evaluacion prueba exactamente la configuracion de la API.
# Prioridad: variable de entorno > configuracion.env > valor por defecto.
#
# Los hosts son los que usa la API cuando corre EN LA NOTEBOOK (localhost +
# puertos publicados por cada docker-compose). Si la API corriera dentro de un
# contenedor, habria que usar nombres de servicio y puertos internos
# (ver docs/topologia_y_entornos.md).

# --- Evaluacion ---
TIMEOUT_S=3.0
API_BASE_URL=http://localhost:8000

# --- MongoDB (Hito 4) ---
# Credencial de laboratorio del compose del Hito 4 (ver su README).
MONGODB_URI=mongodb://<usuario>:<password>@localhost:27017/?authSource=admin
MONGODB_DATABASE=fixture2030
MONGO_CONTAINER=fixture2030-mongodb

# --- Neo4j (Hito 5) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_URL=http://localhost:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=<password de neo4j/.env>
NEO4J_DATABASE=neo4j
NEO4J_CONTAINER=fixture2030-neo4j

# --- Cassandra (Hito 6) --- (sin autenticacion en el laboratorio)
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fixture2030_comentarios
CASSANDRA_CONTAINER=fixture2030-cassandra

# --- Redis (Hito 7) --- (sin password en el laboratorio; si tuviera: redis://:<password>@host:6379/0)
REDIS_URL=redis://localhost:6379/0
REDIS_CONTAINER=fixture2030-redis

# --- InfluxDB 3 Core (Hito 8) ---
INFLUX_URL=http://127.0.0.1:8181
INFLUX_DATABASE=fixture2030_vivo
# El token NO se copia: se lee del archivo que crea el Hito 8 (ruta relativa a conectividad/).
INFLUXDB3_TOKEN_FILE=../influxdb/.influxdb3-token
INFLUX_CONTAINER=fixture2030-influxdb

# --- IRIS (Hito 9) ---
IRIS_HOST=127.0.0.1
IRIS_PORT=1972
IRIS_PORTAL_URL=http://127.0.0.1:52773
IRIS_NAMESPACE=USER
IRIS_USER=_SYSTEM
# IRIS Community exige cambiar la password predeterminada: usar la password
# local definida en la preparacion (README, paso 3).
IRIS_PASSWORD=<password local de IRIS>
IRIS_CONTAINER=fixture2030-iris

# --- Datos de prueba (lecturas minimas sobre los datos de laboratorio del equipo) ---
PRUEBA_EQUIPO=ARG
PRUEBA_PARTIDO=F2030-001
PRUEBA_PARTIDO_INEXISTENTE=F2030-999
PRUEBA_CASSANDRA_PARTIDO=F2030-063
PRUEBA_CASSANDRA_INSTANTE=2030-06-22T20:03:00Z
PRUEBA_SESION=S0001
PRUEBA_INFLUX_PARTIDO=F2030-018
PRUEBA_INFLUX_DESDE=2030-06-13T08:00:00Z
PRUEBA_INFLUX_HASTA=2030-06-13T08:05:00Z
