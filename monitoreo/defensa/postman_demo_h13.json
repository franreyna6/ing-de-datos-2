{
  "info": {
    "name": "Fixture 2030 - Demo de la defensa (Hito 13)",
    "description": "Coleccion del Hito 10 con las variables ajustadas a datos de laboratorio que devuelven 200 (los mismos del Hito 11) y una carpeta de Monitoreo. baseUrl usa 127.0.0.1: en Windows localhost prueba IPv6 primero y suma demoras (diagnostico C2 del Hito 11). Orden sugerido: ver monitoreo/defensa/demo.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "equipoCodigo",
      "value": "ARG"
    },
    {
      "key": "partidoCodigo",
      "value": "F2030-001"
    },
    {
      "key": "partidoComentarios",
      "value": "F2030-063"
    },
    {
      "key": "sesionId",
      "value": "S0001"
    },
    {
      "key": "statsDesde",
      "value": "2030-06-13T08:00:00Z"
    },
    {
      "key": "statsHasta",
      "value": "2030-06-13T08:05:00Z"
    },
    {
      "key": "prometheusUrl",
      "value": "http://127.0.0.1:9090"
    },
    {
      "key": "partidoVivo",
      "value": "H13-DEMO-URUARG"
    },
    {
      "key": "sesionVivo",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Sistema",
      "item": [
        {
          "name": "GET /salud - estado de la API y fuentes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/salud"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 y lista de dependencias', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().dependencias).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Demo en vivo (un partido, seis bases)",
      "description": "Partido de laboratorio H13-DEMO-URUARG. IRIS decide (reglas), Neo4j conecta el evento, Redis guarda sesion/estado, Cassandra el feed, InfluxDB las estadisticas y MongoDB las fichas. Correr en orden.",
      "item": [
        {
          "name": "1. POST /vivo/partidos - crear (IRIS -> Neo4j -> Redis)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/vivo/partidos",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"{{partidoVivo}}\",\n  \"local\": \"URU\",\n  \"visitante\": \"ARG\",\n  \"sede\": \"CENT\",\n  \"fecha\": \"2030-06-08\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Programado', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().partido.estado).to.eql('Programado'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2. POST iniciar (IRIS valida la transicion)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/vivo/partidos/{{partidoVivo}}/iniciar"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('EnJuego', () => pm.expect(pm.response.json().partido.estado).to.eql('EnJuego'));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. POST /sesiones - login de hincha (Redis, TTL 1800)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/sesiones",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": \"u-00042\",\n  \"rol\": \"hincha\",\n  \"partido\": \"{{partidoVivo}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('sesionVivo', pm.response.json().sesionId);"
                ]
              }
            }
          ]
        },
        {
          "name": "4. POST actividad - renueva el TTL (deslizante)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/sesiones/{{sesionVivo}}/actividad"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TTL vuelve a 1800', () => pm.expect(pm.response.json().ttlSegundos).to.eql(1800));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. POST evento - gol (IRIS decide, Neo4j conecta)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/vivo/partidos/{{partidoVivo}}/eventos",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"Gol\",\n  \"minuto\": 23,\n  \"jugadorCodigo\": \"URU-4-blpv45\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 y marcador 1-0', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().partido.golesLocal).to.eql(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "6. POST comentario (Cassandra, particion partido+ventana)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/partidos/{{partidoVivo}}/comentarios",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": \"u-00042\",\n  \"contenido\": \"Golazo en el Centenario\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "7. POST estadisticas (InfluxDB, line protocol)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/vivo/partidos/{{partidoVivo}}/estadisticas",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sede\": \"CENT\",\n  \"grupo\": \"-\",\n  \"puntos\": [\n    {\n      \"equipoId\": \"URU\",\n      \"posesionPct\": 54.5,\n      \"pasesAcum\": 120,\n      \"tirosAcum\": 4,\n      \"recuperacionesAcum\": 18\n    },\n    {\n      \"equipoId\": \"ARG\",\n      \"posesionPct\": 45.5,\n      \"pasesAcum\": 101,\n      \"tirosAcum\": 2,\n      \"recuperacionesAcum\": 15\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "8. GET tablero - las 6 bases en paralelo",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/vivo/partidos/{{partidoVivo}}/tablero?local=URU&visitante=ARG"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('6 secciones', () => pm.expect(Object.keys(pm.response.json().secciones)).to.have.length(6));"
                ]
              }
            }
          ]
        },
        {
          "name": "9. POST finalizar (IRIS)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/vivo/partidos/{{partidoVivo}}/finalizar"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Finalizado', () => pm.expect(pm.response.json().partido.estado).to.eql('Finalizado'));"
                ]
              }
            }
          ]
        },
        {
          "name": "10. POST gol con el partido Finalizado -> 409 (regla de IRIS)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/vivo/partidos/{{partidoVivo}}/eventos",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"Gol\",\n  \"minuto\": 95,\n  \"jugadorCodigo\": \"URU-4-blpv45\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409: IRIS rechaza el evento', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "MongoDB (equipos y jugadores)",
      "item": [
        {
          "name": "GET /equipos/{codigo} - equipo existente",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/equipos/{{equipoCodigo}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 con codigo y nombre', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.have.property('codigo');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /equipos/{codigo} - inexistente (404)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/equipos/ZZZ"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 con error de dominio', () => {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.json().error.code).to.eql('TEAM_NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /equipos/{codigo}/jugadores - paginado",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/equipos/{{equipoCodigo}}/jugadores?limit=5&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipos",
                "{{equipoCodigo}}",
                "jugadores"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "GET /equipos/.../jugadores - limit invalido (400)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/equipos/{{equipoCodigo}}/jugadores?limit=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipos",
                "{{equipoCodigo}}",
                "jugadores"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "0"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 de validacion', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Neo4j (eventos del partido)",
      "item": [
        {
          "name": "GET /partidos/{codigo}/eventos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/partidos/{{partidoCodigo}}/eventos"
          }
        }
      ]
    },
    {
      "name": "Cassandra (comentarios)",
      "item": [
        {
          "name": "GET /partidos/{codigo}/comentarios?instante=...",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/partidos/{{partidoComentarios}}/comentarios?instante=2030-06-22T20:23:00Z&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "partidos",
                "{{partidoComentarios}}",
                "comentarios"
              ],
              "query": [
                {
                  "key": "instante",
                  "value": "2030-06-22T20:23:00Z"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "POST /partidos/{codigo}/comentarios - publicar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": \"u-00042\",\n  \"contenido\": \"Gran jugada en el minuto 15\"\n}"
            },
            "url": "{{baseUrl}}/partidos/{{partidoComentarios}}/comentarios"
          }
        }
      ]
    },
    {
      "name": "Redis (sesiones)",
      "item": [
        {
          "name": "GET /sesiones/{id} - activa o 404 si expiro",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/sesiones/{{sesionId}}"
          }
        },
        {
          "name": "GET /sesiones/{id} - inexistente (404)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/sesiones/no-existe"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 sesion ausente/expirada', () => {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.json().error.code).to.eql('SESSION_EXPIRED_OR_NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "InfluxDB (estadisticas)",
      "item": [
        {
          "name": "GET /partidos/{codigo}/estadisticas - ventana",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/partidos/F2030-018/estadisticas?desde={{statsDesde}}&hasta={{statsHasta}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "partidos",
                "F2030-018",
                "estadisticas"
              ],
              "query": [
                {
                  "key": "desde",
                  "value": "{{statsDesde}}"
                },
                {
                  "key": "hasta",
                  "value": "{{statsHasta}}"
                }
              ]
            }
          }
        },
        {
          "name": "GET estadisticas - fechas invertidas (400)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/partidos/F2030-018/estadisticas?desde={{statsHasta}}&hasta={{statsDesde}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "partidos",
                "F2030-018",
                "estadisticas"
              ],
              "query": [
                {
                  "key": "desde",
                  "value": "{{statsHasta}}"
                },
                {
                  "key": "hasta",
                  "value": "{{statsDesde}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 de validacion', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "IRIS (detalle del partido)",
      "item": [
        {
          "name": "GET /partidos/{codigo}/detalle",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/partidos/{{partidoCodigo}}/detalle"
          }
        }
      ]
    },
    {
      "name": "Monitoreo (Hito 13)",
      "item": [
        {
          "name": "GET /metrics - metricas de la API para Prometheus",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/metrics",
            "description": "Formato de texto de Prometheus. Buscar fixture_api_requests_total y fixture_dependencia_disponible."
          }
        },
        {
          "name": "Prometheus - targets UP/DOWN (PromQL: up)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{prometheusUrl}}/api/v1/query?query=up",
            "description": "1 = Prometheus pudo leer el target."
          }
        },
        {
          "name": "Prometheus - disponibilidad por base vista por la API",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{prometheusUrl}}/api/v1/query?query=fixture_dependencia_disponible",
            "description": "1 = la base respondio al chequeo de protocolo."
          }
        },
        {
          "name": "Prometheus - latencia p95 por base (1m)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{prometheusUrl}}/api/v1/query?query=histogram_quantile(0.95,%20sum%20by%20(le,%20fuente)%20(rate(fixture_dependencia_duration_seconds_bucket[1m])))",
            "description": "Segundos. Compara las 6 bases."
          }
        },
        {
          "name": "Prometheus - alertas disparadas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{prometheusUrl}}/api/v1/alerts",
            "description": "Estado de las reglas de reglas-o-alertas.yml."
          }
        }
      ]
    }
  ]
}